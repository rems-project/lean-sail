import Sail

/-! Models generated by Sail 0.20 and earlier write `assert c m` as a `do` element. Recent Lean
versions parse that as their own `assert`; the scoped macro in `Sail/Sail.lean` keeps it a call
to the model's `assert`. -/

open Sail
open Sail.ConcurrencyInterfaceV1
open PreSail

namespace SailTest.OldAssert

inductive R where | r deriving DecidableEq, Hashable
abbrev SailM := PreSailM (fun (_ : R) => Nat) trivialChoiceSource Empty

-- The model-level copy such a model defines.
abbrev assert (p : Bool) (s : String) : SailM Unit := PreSail.assert p s

def checkZero (x : Nat) : SailM Unit := do
  assert (x == 0) "x must be zero"
  pure ()

end SailTest.OldAssert
